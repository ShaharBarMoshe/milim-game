{
  "name": "balloon-archer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sprites": "python3 -I tools/slice_sprites.py",
    "kids": "python3 -I tools/draw_kids.py",
    "characters": "python3 -I tools/slice_characters.py",
    "divers": "python3 -I tools/slice_divers.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler pages deploy dist --project-name milim-game",
    "test": "vitest run",
    "test:e2e": "PW_DISABLE_TS_ESM=1 playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "vite": "^6.3.5",
    "vitest": "3.2.4"
  }
}
